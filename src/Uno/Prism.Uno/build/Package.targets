<Project>
  <PropertyGroup>
    <UnoGlobalXamlNamespaceUri Condition="'$(UnoGlobalXamlNamespaceUri)' == ''">http://schemas.microsoft.com/winfx/2006/xaml/presentation/global</UnoGlobalXamlNamespaceUri>
  </PropertyGroup>
  <!-- Generate consumer-owned global mappings so each project can disable them. -->
  <ItemGroup Condition=" '$(UsingUnoSdk)' == 'true' AND '$(PrismUnoGlobalXmlns)' != 'false' AND '$(TargetFramework)' != '' AND !$(TargetFramework.Contains('windows10')) ">
    <PrismUnoGlobalXmlnsAttribute Include="System.Windows.Markup.XmlnsDefinitionAttribute">
      <_Parameter1>$(UnoGlobalXamlNamespaceUri)</_Parameter1>
      <_Parameter2>Prism</_Parameter2>
    </PrismUnoGlobalXmlnsAttribute>
    <PrismUnoGlobalXmlnsAttribute Include="System.Windows.Markup.XmlnsDefinitionAttribute">
      <_Parameter1>$(UnoGlobalXamlNamespaceUri)</_Parameter1>
      <_Parameter2>Prism.Navigation.Regions</_Parameter2>
    </PrismUnoGlobalXmlnsAttribute>
    <PrismUnoGlobalXmlnsAttribute Include="System.Windows.Markup.XmlnsDefinitionAttribute">
      <_Parameter1>$(UnoGlobalXamlNamespaceUri)</_Parameter1>
      <_Parameter2>Prism.Navigation.Regions.Behaviors</_Parameter2>
    </PrismUnoGlobalXmlnsAttribute>
    <PrismUnoGlobalXmlnsAttribute Include="System.Windows.Markup.XmlnsDefinitionAttribute">
      <_Parameter1>$(UnoGlobalXamlNamespaceUri)</_Parameter1>
      <_Parameter2>Prism.Mvvm</_Parameter2>
    </PrismUnoGlobalXmlnsAttribute>
    <PrismUnoGlobalXmlnsAttribute Include="System.Windows.Markup.XmlnsDefinitionAttribute">
      <_Parameter1>$(UnoGlobalXamlNamespaceUri)</_Parameter1>
      <_Parameter2>Prism.Interactivity</_Parameter2>
    </PrismUnoGlobalXmlnsAttribute>
    <PrismUnoGlobalXmlnsAttribute Include="System.Windows.Markup.XmlnsDefinitionAttribute">
      <_Parameter1>$(UnoGlobalXamlNamespaceUri)</_Parameter1>
      <_Parameter2>Prism.Dialogs</_Parameter2>
    </PrismUnoGlobalXmlnsAttribute>
    <PrismUnoGlobalXmlnsAttribute Include="System.Windows.Markup.XmlnsDefinitionAttribute">
      <_Parameter1>$(UnoGlobalXamlNamespaceUri)</_Parameter1>
      <_Parameter2>Prism.Ioc</_Parameter2>
    </PrismUnoGlobalXmlnsAttribute>
  </ItemGroup>
  <Target Name="GeneratePrismUnoGlobalXmlns"
          BeforeTargets="BeforeCompile;CoreCompile"
          DependsOnTargets="PrepareForBuild"
          Condition="'@(PrismUnoGlobalXmlnsAttribute)' != ''">
    <WriteCodeFragment AssemblyAttributes="@(PrismUnoGlobalXmlnsAttribute)"
                       Language="$(Language)"
                       OutputFile="$(IntermediateOutputPath)PrismUno.GlobalXmlns.g$(DefaultLanguageSourceExtension)">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>
</Project>
