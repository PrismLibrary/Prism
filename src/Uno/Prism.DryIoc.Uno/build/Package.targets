<Project>
  <ItemGroup Condition=" '$(ImplicitUsings)' == 'true' OR '$(ImplicitUsings)' == 'enable' ">
    <Using Include="DryIoc" />
    <Using Include="Prism.DryIoc" />
  </ItemGroup>
  <PropertyGroup>
    <UnoGlobalXamlNamespaceUri Condition="'$(UnoGlobalXamlNamespaceUri)' == ''">http://schemas.microsoft.com/winfx/2006/xaml/presentation/global</UnoGlobalXamlNamespaceUri>
  </PropertyGroup>
  <!-- Generate consumer-owned global mappings so applications can disable them. -->
  <ItemGroup Condition=" '$(UsingUnoSdk)' == 'true' AND '$(PrismUnoGlobalXmlns)' != 'false' AND '$(TargetFramework)' != '' AND !$(TargetFramework.Contains('windows10')) ">
    <AssemblyAttribute Include="System.Windows.Markup.XmlnsDefinitionAttribute">
      <_Parameter1>$(UnoGlobalXamlNamespaceUri)</_Parameter1>
      <_Parameter2>Prism.DryIoc</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
