<Page
    x:Class="Playground.Module.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:prism="using:Prism.Interactivity"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <ScrollViewer Padding="28" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
      <StackPanel Spacing="8">
        <TextBlock Text="Build with Prism. Explore with confidence." FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="A working Sandbox for native WinUI 3. Navigate between real module-provided views, explore nested regions and exchange results with dialogs."
                   TextWrapping="Wrap" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Regions &amp; navigation" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Open Alpha and Beta details, then step back through the nested journal. The shell's back button navigates the main region independently."
                     TextWrapping="Wrap" />
          <Button Content="Explore regions" Style="{StaticResource AccentButtonStyle}">
            <i:Interaction.Behaviors>
              <i:EventTriggerBehavior EventName="Click">
                <prism:InvokeCommandAction Command="{Binding GoToRegionLabCommand}" />
              </i:EventTriggerBehavior>
            </i:Interaction.Behaviors>
          </Button>
          <TextBlock Text="This button uses EventTriggerBehavior and Prism InvokeCommandAction."
                     FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Border>
      <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Dialogs" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Send parameters to a notification, or confirm and cancel an action. See the returned result in the page."
                     TextWrapping="Wrap" />
          <Button Content="Explore dialogs" Command="{Binding GoToDialogLabCommand}" />
        </StackPanel>
      </Border>
      <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Modules" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="The feature pages and dialogs are registered by PlaygroundModule, separate from the shell application."
                     TextWrapping="Wrap" />
          <Button Content="Explore modules" Command="{Binding GoToModuleCommand}" />
        </StackPanel>
      </Border>
      <TextBlock Text="Native Windows App SDK • DryIoc • No Uno hosting dependencies"
                 FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </ScrollViewer>
</Page>
