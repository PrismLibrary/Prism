<Page
    x:Class="HelloWorld.Views.Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="using:Prism.Navigation.Regions"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Padding="24,16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="ms-appx:///Assets/prism-logo.png" Width="48" Height="48"
               AutomationProperties.Name="Prism logo" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Prism Sandbox" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Explore native WinUI composition" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Column="2" Padding="12,6" CornerRadius="12" VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}">
          <TextBlock Text="WinUI 3" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>
    <NavigationView Grid.Row="1" x:Name="MainNavigation"
                    prism:RegionManager.RegionName="ContentRegion"
                    IsSettingsVisible="false" IsBackButtonVisible="Visible"
                    PaneDisplayMode="Auto" OpenPaneLength="240">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Home" Tag="HomeView" Icon="Home" />
        <NavigationViewItem Content="Regions &amp; navigation" Tag="RegionLabView" Icon="Switch" />
        <NavigationViewItem Content="Dialogs" Tag="DialogLabView" Icon="Message" />
        <NavigationViewItem Content="Modules" Tag="ModuleAboutView" Icon="Library" />
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <TextBlock Text="Prism • Native Windows App SDK" Margin="16" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
      </NavigationView.PaneFooter>
    </NavigationView>
    <Grid Grid.Row="1" x:Name="LoadingOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <Image Source="ms-appx:///Assets/prism-logo.png" Width="72" Height="72" AutomationProperties.Name="Prism logo" />
        <ProgressRing x:Name="LoadingProgress" IsActive="True" Width="40" Height="40" />
        <TextBlock Text="Preparing your Sandbox…" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
