<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrismMauiDemo.ViewModels"
             x:Class="PrismMauiDemo.Views.BackConfirmationMenuPage"
             x:DataType="vm:MainPageViewModel"
             Title="Back confirmation lab">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Button Text="Synchronous confirmation" AutomationId="SyncBack"
                Command="{Binding NavigateCommand}" CommandParameter="SyncBackConfirmation" />
        <Button Text="Async confirmation (2 seconds)" AutomationId="AsyncBack"
                Command="{Binding NavigateCommand}" CommandParameter="AsyncBackConfirmation" />
    </VerticalStackLayout>
</ContentPage>
