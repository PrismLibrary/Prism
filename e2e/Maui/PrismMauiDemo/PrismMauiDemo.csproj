<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net11.0-android;net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041;net11.0-windows10.0.19041</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>PrismMauiDemo</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnablePreviewMsixTooling>true</EnablePreviewMsixTooling>
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>

    <!-- Display name -->
    <ApplicationTitle>Prism Maui</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.prismlibrary.prismmauidemo</ApplicationId>
    <ApplicationIdGuid>9420c397-cc28-4029-a4d5-2d780345b109</ApplicationIdGuid>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Required for C# Hot Reload -->
    <UseInterpreter Condition="'$(Configuration)' == 'Debug' and $(TargetFramework.StartsWith('net10'))">True</UseInterpreter>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.StartsWith('net11')) and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Opt in on the app only. Do not pass PublishAot as a global command-line property:
       it would flow into referenced libraries. -->
  <PropertyGroup Condition="'$(PrismNativeAotValidation)' == 'true' and ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android')">
    <PublishAot>true</PublishAot>
    <DefineConstants>$(DefineConstants);PRISM_NATIVE_AOT_VALIDATION</DefineConstants>
    <UseInterpreter>false</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FFFFFF" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Maui\Prism.DryIoc.Maui\Prism.DryIoc.Maui.csproj" Condition="'$(PrismNativeAotValidation)' != 'true'" />
    <ProjectReference Include="..\..\..\src\Maui\Prism.Maui.Rx\Prism.Maui.Rx.csproj" />
    <ProjectReference Include="..\..\..\src\Maui\Prism.Maui\Prism.Maui.csproj" />
    <ProjectReference Include="..\MauiModule\MauiModule.csproj" />
    <ProjectReference Include="..\MauiRegionsModule\MauiRegionsModule.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PrismNativeAotValidation)' == 'true' and '$(PrismNativeAotContainerVersion)' != ''">
    <PackageReference Include="Prism.Container.Microsoft" VersionOverride="$(PrismNativeAotContainerVersion)" />
  </ItemGroup>

  <Target Name="ValidateNativeAotConfiguration" BeforeTargets="CollectPackageReferences;PrepareForBuild"
          Condition="'$(PrismNativeAotValidation)' == 'true'">
    <Error Condition="'$(PrismNativeAotContainerVersion)' == ''"
           Text="NativeAOT validation requires PrismNativeAotContainerVersion from matching real Prism.Container.Microsoft and Prism.Container.Abstractions local/private packages. See the app's NativeAOT validation instructions; no package version is assumed." />
  </Target>

  <Target Name="ValidateNativeAotBuild" BeforeTargets="PrepareForBuild"
          Condition="'$(PrismNativeAotValidation)' == 'true'">
    <Error Condition="'$(Configuration)' != 'Release' or '$(PublishAot)' != 'true'"
           Text="PrismNativeAotValidation requires Release and an Android or iOS target framework." />
  </Target>

</Project>
