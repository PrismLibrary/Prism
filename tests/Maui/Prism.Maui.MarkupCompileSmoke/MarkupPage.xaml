<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:prism="http://prismlibrary.com"
             x:Class="Prism.Maui.MarkupCompileSmoke.MarkupPage">
  <VerticalStackLayout>
    <Label BindingContext="{prism:Parameter Key=message, Value=compiled}" Text="Parameter smoke" />
    <Button Text="Navigate" Command="{prism:NavigateTo NextPage}" />
    <Button Text="Back" Command="{prism:GoBack}" />
    <Button Text="Dialog" Command="{prism:ShowDialog SampleDialog}" />
  </VerticalStackLayout>
</ContentPage>
