<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <RootNamespace>Prism.Uno.XamlConsumer</RootNamespace>
    <DefaultItemExcludes Condition="'$(XamlConsumerCase)' != ''">$(DefaultItemExcludes);**/*.xaml</DefaultItemExcludes>
    <DefaultItemExcludes Condition="'$(PrismUnoGlobalXmlns)' == 'false' AND '$(XamlConsumerCase)' == ''">$(DefaultItemExcludes);ImplicitNamespaces.xaml</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="UnoGlobalXamlNamespaceUri" Value="$(UnoGlobalXamlNamespaceUri)" />
    <AssemblyMetadata Include="PrismUnoGlobalXmlns" Value="true" Condition="'$(PrismUnoGlobalXmlns)' != 'false'" />
    <AssemblyMetadata Include="PrismUnoGlobalXmlns" Value="false" Condition="'$(PrismUnoGlobalXmlns)' == 'false'" />
    <ProjectReference Include="..\..\..\src\Uno\Prism.DryIoc.Uno\Prism.DryIoc.Uno.WinUI.csproj" Condition="'$(PrismPackageVersion)' == ''" />
    <PackageReference Include="Prism.DryIoc.Uno.WinUI" VersionOverride="$(PrismPackageVersion)" Condition="'$(PrismPackageVersion)' != ''" />
    <Page Include="$(XamlConsumerCase).xaml" Condition="'$(XamlConsumerCase)' != ''" />
  </ItemGroup>
  <!-- Project references do not import NuGet buildTransitive assets. -->
  <Import Project="../../../src/Uno/Prism.Uno/build/Package.targets" Condition="'$(PrismPackageVersion)' == ''" />
  <Import Project="../../../src/Uno/Prism.DryIoc.Uno/build/Package.targets" Condition="'$(PrismPackageVersion)' == ''" />
</Project>
